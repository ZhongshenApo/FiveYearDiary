{
  "name": "five-year-diary",
  "version": "1.0.1",
  "description": "A local-first 5-year diary desktop application",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run start:client\" \"wait-on http://localhost:5173 && electron .\"",
    "start:client": "cd client && pnpm dev",
    "build:client": "cd client && pnpm build",
    "pack": "npm run build:client && electron-builder --dir",
    "dist": "npm run build:client && electron-builder"
  },
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.example.fiveyeardiary",
    "productName": "FiveYearDiary",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server/**/*",
      "client/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.lifestyle"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}
